import gradio as gr
import requests
import base64
from PIL import Image
import io
import cv2
import os
import json
import re

# -------------------- GEMINI API CONFIG --------------------
GEMINI_API_KEY = "YOUR API KEY"
GEMINI_URL = "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent"

# -------------------- FUNCTION: CLEAN GEMINI RESPONSE --------------------
def clean_response(text_out):
    # Remove markdown formatting like ```json ... ```
    text_out = re.sub(r"```.*?```", lambda m: m.group(0).replace("```json", "").replace("```", ""), text_out, flags=re.DOTALL)
    text_out = text_out.strip()

    # Try to parse as JSON
    try:
        parsed = json.loads(text_out)
        if not parsed.get("is_sign", False):
            return None
        # ✅ Clean formatted output
        return (
            f"🚦 Traffic Sign Analysis\n"
            f"----------------------------------------\n"
            f"✔️ Is it a traffic sign? ✅ Yes\n\n"
            f"📛 Name of Sign:\n➡️ {parsed.get('name', 'Unknown Sign')}\n\n"
            f"📖 Meaning:\n{parsed.get('meaning', '')}\n\n"
            f"⚠️ Instructions for Drivers:\n{parsed.get('instruction', '')}\n"
            f"----------------------------------------"
        )
    except:
        if "NOT_SIGN" in text_out.upper():
            return None
        return f"🚦 Traffic Sign Analysis\n{text_out}"


# -------------------- FUNCTION: CALL GEMINI --------------------
def call_gemini(img: Image.Image):
    # Convert image to base64
    buffered = io.BytesIO()
    img.convert("RGB").save(buffered, format="JPEG")
    img_base64 = base64.b64encode(buffered.getvalue()).decode()

    # Prompt (tell Gemini: NO markdown, only JSON)
    prompt = """
    You are a traffic sign recognition expert.
    Rules:
    - If it is NOT a traffic sign, return: {"is_sign": false}
    - If it IS a traffic sign, return ONLY valid JSON (without markdown/code blocks):
    {
      "is_sign": true,
      "name": "Name of sign",
      "meaning": "Meaning of the sign",
      "instruction": "Driving rule/instruction"
    }
    """

    payload = {
        "contents": [
            {
                "parts": [
                    {"text": prompt},
                    {
                        "inline_data": {
                            "mime_type": "image/jpeg",
                            "data": img_base64
                        }
                    }
                ]
            }
        ]
    }

    headers = {
        "Content-Type": "application/json",
        "X-goog-api-key": GEMINI_API_KEY
    }

    try:
        response = requests.post(GEMINI_URL, headers=headers, json=payload)
        result = response.json()

        text_out = (
            result.get("candidates", [{}])[0]
                  .get("content", {})
                  .get("parts", [{}])[0]
                  .get("text", "")
        ).strip()

        if not text_out:
            return None

        return clean_response(text_out)

    except Exception as e:
        return f"❌ API Error: {str(e)}"


# -------------------- FUNCTION: ANALYZE IMAGE --------------------
def analyze_traffic_sign(img: Image.Image):
    output = call_gemini(img)
    if output is None:
        return "❌ Error: Uploaded image does not appear to be a traffic sign."
    return output


# -------------------- FUNCTION: ANALYZE VIDEO --------------------
def analyze_traffic_video(video_path):
    # ✅ File size limit (30 MB)
    size_limit_mb = 30
    file_size_mb = os.path.getsize(video_path) / (1024 * 1024)
    if file_size_mb > size_limit_mb:
        return f"❌ Error: File too large ({file_size_mb:.1f} MB). Max allowed size is {size_limit_mb} MB."

    cap = cv2.VideoCapture(video_path)
    frame_rate = int(cap.get(cv2.CAP_PROP_FPS))
    results = []

    frame_count = 0
    while cap.isOpened():
        ret, frame = cap.read()
        if not ret:
            break

        # Sample every 2 seconds
        if frame_rate > 0 and frame_count % (2 * frame_rate) == 0:
            frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            pil_img = Image.fromarray(frame_rgb)

            output = call_gemini(pil_img)
            if output:
                timestamp = frame_count // frame_rate
                results.append(f"⏱️ {timestamp}s →\n{output}")

        frame_count += 1

    cap.release()

    if not results:
        return "❌ No traffic signs detected in the video."
    return "🚦 Traffic Signs Detected in Video:\n\n" + "\n\n".join(results)


# -------------------- GRADIO APP --------------------
with gr.Blocks() as demo:
    gr.Markdown("## 🚦 AI Traffic Sign Recognition (Image + Video) — Gemini Powered")

    with gr.Tab("Upload Image"):
        img_input = gr.Image(type="pil", label="Upload Traffic Sign Image")
        img_output = gr.Textbox(label="Result", lines=15)
        img_button = gr.Button("Analyze Image")
        img_button.click(analyze_traffic_sign, inputs=img_input, outputs=img_output)

    with gr.Tab("Upload Video"):
        vid_input = gr.Video(label="Upload Car View Video")
        vid_output = gr.Textbox(label="Result", lines=15)
        vid_button = gr.Button("Analyze Video")
        vid_button.click(analyze_traffic_video, inputs=vid_input, outputs=vid_output)

# -------------------- LAUNCH APP --------------------
demo.launch()
